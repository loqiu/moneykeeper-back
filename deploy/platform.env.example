# Copy this file to deploy/platform.env on the target host before running docker compose.
MONEYKEEPER_IMAGE_TAG=platform
SPRING_PROFILES_ACTIVE=prod
TZ=Europe/London

MONEYKEEPER_APP_PORT=8082
MONEYKEEPER_SHARED_NETWORK=env_default

MONEYKEEPER_DB_HOST=mysql
MONEYKEEPER_DB_PORT=3306
MONEYKEEPER_DB_NAME=moneykeeper_platform
MONEYKEEPER_DB_USERNAME=moneykeeper
MONEYKEEPER_DB_PASSWORD=change-me-db-password

MONEYKEEPER_REDIS_HOST=redis
MONEYKEEPER_REDIS_PORT=6379
MONEYKEEPER_REDIS_PASSWORD=
MONEYKEEPER_REDIS_DATABASE=1

MONEYKEEPER_ELASTICSEARCH_HOST=elasticsearch
MONEYKEEPER_ELASTICSEARCH_PORT=9200
MONEYKEEPER_ELASTICSEARCH_INDEX_NAME=moneykeeper-records-platform

MONEYKEEPER_JWT_SECRET=change-me-jwt-secret
DUBBO_REGISTRY_ADDRESS=N/A
DUBBO_CONFIG_CENTER_ADDRESS=N/A